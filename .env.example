# =============================================================================
# Food-Coop Infrastructure Environment
# =============================================================================
# Copy this file to `.env` and adjust the values for your local environment.
#
# Do not commit `.env`.
# Commit only `.env.example`.
# =============================================================================


# =============================================================================
# Project
# =============================================================================

COMPOSE_PROJECT_NAME=foodcoops

FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8089


# =============================================================================
# Ports
# =============================================================================

FRONTEND_PORT=3000
BACKEND_PORT=8080
KEYCLOAK_PORT=8089
MARIADB_PORT=3306


# =============================================================================
# MariaDB
# =============================================================================

MARIADB_HOST=mariadb
MARIADB_PORT_INTERNAL=3306
MARIADB_DATABASE=<maria_db>
MARIADB_USER=<maria_db_user>
MARIADB_PASSWORD=<maria_db_password>
MARIADB_ROOT_PASSWORD=<maria_db_root_pw>


# =============================================================================
# Backend / Spring Boot
# =============================================================================

SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mariadb://${MARIADB_HOST}:${MARIADB_PORT_INTERNAL}/${MARIADB_DATABASE}
SPRING_DATASOURCE_USERNAME=${MARIADB_USER}
SPRING_DATASOURCE_PASSWORD=${MARIADB_PASSWORD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver

SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_GENERATE_DDL=true
SPRING_DATASOURCE_INITIALIZATION_MODE=always
SPRING_JPA_SHOW_SQL=true


# =============================================================================
# Backend / Keycloak adapter
# =============================================================================

KEYCLOAK_REALM=foodcoop
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080/
KEYCLOAK_SSL_REQUIRED=true
KEYCLOAK_RESOURCE=foodcoop-backend
KEYCLOAK_CLIENT_SECRET=<secret>
KEYCLOAK_USE_RESOURCE_ROLE_MAPPINGS=true


# =============================================================================
# Keycloak server
# =============================================================================

KEYCLOAK_ADMIN=<keycloak_admin>
KEYCLOAK_ADMIN_PASSWORD=<keycloak_admin_pw>

KC_HTTP_ENABLED=false
KC_DB=mariadb
KC_DB_URL=jdbc:mariadb://${MARIADB_HOST}:${MARIADB_PORT_INTERNAL}/${MARIADB_DATABASE}
KC_DB_USERNAME=${MARIADB_USER}
KC_DB_PASSWORD=${MARIADB_PASSWORD}


# =============================================================================
# Keycloak clients
# =============================================================================

# Public frontend client.
# This client is used by the browser and must not have a secret.
KEYCLOAK_FRONTEND_CLIENT_ID=foodcoop-pwa

# Confidential backend client.
# This client may have a secret because it is only used server-side.
KEYCLOAK_BACKEND_CLIENT_ID=foodcoop-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}


# =============================================================================
# Frontend / Create React App
# =============================================================================
# These values are embedded into the built frontend bundle.
# Never put real secrets here.

REACT_APP_NAME=foodcoops-pwa
REACT_APP_VERSION=local

REACT_APP_BACKEND_URL=http://localhost:8080/
REACT_APP_KEYCLOAK_URL=http://localhost:8089/
REACT_APP_KEYCLOAK_REALM=${KEYCLOAK_REALM}
REACT_APP_KEYCLOAK_CLIENT_ID=${KEYCLOAK_FRONTEND_CLIENT_ID}


# =============================================================================
# Mail
# =============================================================================
# Local development can leave username/password empty unless mail sending is tested.

SPRING_MAIL_HOST=smtp.ionos.de
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
