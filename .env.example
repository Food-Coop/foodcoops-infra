# =============================================================================
# Project
# =============================================================================

COMPOSE_PROJECT_NAME=foodcoops


# =============================================================================
# Server
# =============================================================================

SERVER_IP=94.130.136.176

FRONTEND_PORT=80

BACKEND_PORT_INTERNAL=8080
KEYCLOAK_PORT_INTERNAL=8080
KEYCLOAK_MANAGEMENT_PORT_INTERNAL=9000
MARIADB_PORT_INTERNAL=3306


# =============================================================================
# Keycloak Admin restriction
# =============================================================================

ADMIN_ALLOWED_CIDR=127.0.0.1/32


# =============================================================================
# Backend Database
# =============================================================================

BACKEND_DB_HOST=backend-db

BACKEND_DB_DATABASE=foodcoops
BACKEND_DB_USER=foodcoops
BACKEND_DB_PASSWORD=CHANGE_ME
BACKEND_DB_ROOT_PASSWORD=CHANGE_ME


# =============================================================================
# Spring Boot
# =============================================================================

SERVER_PORT=${BACKEND_PORT_INTERNAL}

SPRING_DATASOURCE_URL=jdbc:mariadb://${BACKEND_DB_HOST}:${MARIADB_PORT_INTERNAL}/${BACKEND_DB_DATABASE}

SPRING_DATASOURCE_USERNAME=${BACKEND_DB_USER}
SPRING_DATASOURCE_PASSWORD=${BACKEND_DB_PASSWORD}

SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver

SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_GENERATE_DDL=false
SPRING_JPA_SHOW_SQL=true

SPRING_SQL_INIT_MODE=always


# =============================================================================
# Keycloak
# =============================================================================

KEYCLOAK_REALM=foodcoop

KEYCLOAK_FRONTEND_CLIENT_ID=foodcoop-pwa
KEYCLOAK_BACKEND_CLIENT_ID=foodcoop-backend


# =============================================================================
# Spring Security / JWT
# =============================================================================

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://${SERVER_IP}/auth/realms/${KEYCLOAK_REALM}

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:${KEYCLOAK_PORT_INTERNAL}/auth/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs


# =============================================================================
# Keycloak Database
# =============================================================================

KEYCLOAK_DB_HOST=keycloak-db

KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_ROOT_PASSWORD=CHANGE_ME


# =============================================================================
# Keycloak Server
# =============================================================================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

KC_DB=mariadb

KC_DB_URL_HOST=${KEYCLOAK_DB_HOST}
KC_DB_URL_PORT=${MARIADB_PORT_INTERNAL}
KC_DB_URL_DATABASE=${KEYCLOAK_DB_DATABASE}

KC_DB_USERNAME=${KEYCLOAK_DB_USER}
KC_DB_PASSWORD=${KEYCLOAK_DB_PASSWORD}

KC_HTTP_ENABLED=true
KC_HTTP_RELATIVE_PATH=/auth

KC_HOSTNAME=http://${SERVER_IP}/auth
KC_HOSTNAME_STRICT=true

KC_PROXY_HEADERS=xforwarded

KC_HEALTH_ENABLED=true


# =============================================================================
# React
# =============================================================================

REACT_APP_NAME=foodcoops-pwa
REACT_APP_VERSION=local

REACT_APP_BACKEND_URL=/api/
REACT_APP_KEYCLOAK_URL=/auth/

REACT_APP_KEYCLOAK_REALM=${KEYCLOAK_REALM}
REACT_APP_KEYCLOAK_CLIENT_ID=${KEYCLOAK_FRONTEND_CLIENT_ID}


# =============================================================================
# Mail
# =============================================================================

SPRING_MAIL_HOST=smtp.ionos.de
SPRING_MAIL_PORT=587

SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true