# =============================================================================
# Food-Coop Infrastructure Environment
# =============================================================================
#
# Copy:
#
#   cp .env.example .env
#
# Never commit .env.
#
# =============================================================================


# =============================================================================
# Project
# =============================================================================

COMPOSE_PROJECT_NAME=foodcoops


# =============================================================================
# Public Server / Domains
# =============================================================================

# Server IP - primarily useful for DNS/debugging now.
SERVER_IP=94.130.136.176

# Canonical application hostname.
DOMAIN=mika.foodcoop.fun

# Root domain redirects to DOMAIN.
ROOT_DOMAIN=foodcoop.fun


# =============================================================================
# Public URLs
# =============================================================================

FRONTEND_PUBLIC_URL=https://${DOMAIN}

BACKEND_PUBLIC_URL=https://${DOMAIN}/api

KEYCLOAK_PUBLIC_URL=https://${DOMAIN}/auth


# =============================================================================
# Public Ports
# =============================================================================

FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443


# =============================================================================
# Internal Docker Ports
# =============================================================================

BACKEND_PORT_INTERNAL=8080

KEYCLOAK_PORT_INTERNAL=8080
KEYCLOAK_MANAGEMENT_PORT_INTERNAL=9000

MARIADB_PORT_INTERNAL=3306


# =============================================================================
# Let's Encrypt / Certbot
# =============================================================================
#
# Use a real email address.
#
# Certificates will be issued for:
#
#   foodcoop.fun
#   mika.foodcoop.fun
#
# =============================================================================

LETSENCRYPT_EMAIL=CHANGE_ME@example.com

CERTBOT_CERT_NAME=foodcoop.fun



# =============================================================================
# Backend Database
# =============================================================================

BACKEND_DB_HOST=backend-db

BACKEND_DB_DATABASE=foodcoops
BACKEND_DB_USER=foodcoops

BACKEND_DB_PASSWORD=CHANGE_ME
BACKEND_DB_ROOT_PASSWORD=CHANGE_ME


# =============================================================================
# Spring Boot
# =============================================================================

SERVER_PORT=${BACKEND_PORT_INTERNAL}


# -----------------------------------------------------------------------------
# Datasource
# -----------------------------------------------------------------------------

SPRING_DATASOURCE_URL=jdbc:mariadb://${BACKEND_DB_HOST}:${MARIADB_PORT_INTERNAL}/${BACKEND_DB_DATABASE}

SPRING_DATASOURCE_USERNAME=${BACKEND_DB_USER}
SPRING_DATASOURCE_PASSWORD=${BACKEND_DB_PASSWORD}

SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver


# -----------------------------------------------------------------------------
# JPA / Hibernate
# -----------------------------------------------------------------------------
#
# For the current fresh field-test database, "update" is useful because
# Hibernate creates missing tables.
#
# Later switch this to validate/none and use Flyway/Liquibase!
#
# =============================================================================

SPRING_JPA_HIBERNATE_DDL_AUTO=update

SPRING_JPA_GENERATE_DDL=false

SPRING_JPA_SHOW_SQL=true

SPRING_SQL_INIT_MODE=never


# =============================================================================
# Keycloak Realm / Clients
# =============================================================================

KEYCLOAK_REALM=foodcoop

KEYCLOAK_FRONTEND_CLIENT_ID=foodcoop-pwa

KEYCLOAK_BACKEND_CLIENT_ID=foodcoop-backend


# -----------------------------------------------------------------------------
# Benutzerverwaltung im Frontend (Konfiguration -> Benutzer & Rollen)
# -----------------------------------------------------------------------------
#
# Das Backend ruft die Keycloak Admin API mit dem Service Account des
# vertraulichen Clients KEYCLOAK_BACKEND_CLIENT_ID auf.
#
# In Keycloak (Realm foodcoop):
#
#   1. Clients -> foodcoop-backend:
#        Client authentication = On, Service accounts roles = On
#   2. Clients -> foodcoop-backend -> Service accounts roles -> Assign role
#        -> Filter by clients -> realm-management:
#        view-users, query-users, manage-users,
#        view-clients, query-clients, manage-clients,
#        view-realm (nötig, wenn Admin eine Realm-Rolle ist)
#   3. Clients -> foodcoop-backend -> Credentials -> Client secret
#        in KEYCLOAK_BACKEND_CLIENT_SECRET eintragen
#   4. Clients -> foodcoop-pwa -> Roles -> Rolle KEYCLOAK_ADMIN_ROLE
#        (Standard: Admin) anlegen und den gewünschten Personen zuweisen
#   5. Ebenso Rolle KEYCLOAK_ORGANISATOR_ROLE (Standard: Organisator):
#        legt fest, was final beim Händler bestellt wird
#
#   Verwaltet werden die Client-Rollen von KEYCLOAK_ROLE_CLIENT_ID
#   (leer = Realm-Rollen).
#
# -----------------------------------------------------------------------------

KEYCLOAK_SERVER_URL=http://keycloak:${KEYCLOAK_PORT_INTERNAL}/auth

KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME

KEYCLOAK_ADMIN_ROLE=Admin

KEYCLOAK_ORGANISATOR_ROLE=Organisator

KEYCLOAK_ROLE_CLIENT_ID=${KEYCLOAK_FRONTEND_CLIENT_ID}

# true = alle Backend-Endpunkte verlangen ein gültiges Keycloak-Token
SECURITY_REQUIRE_AUTHENTICATION=false


# =============================================================================
# Spring Security / JWT
# =============================================================================
#
# Public issuer must match what Keycloak puts into the JWT.
#
# JWKS can still be fetched directly over the internal Docker network.
#
# =============================================================================

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://${DOMAIN}/auth/realms/${KEYCLOAK_REALM}

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:${KEYCLOAK_PORT_INTERNAL}/auth/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs


# =============================================================================
# Keycloak Database
# =============================================================================

KEYCLOAK_DB_HOST=keycloak-db

KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak

KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_ROOT_PASSWORD=CHANGE_ME


# =============================================================================
# Keycloak Server
# =============================================================================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

KC_DB=mariadb

KC_DB_URL_HOST=${KEYCLOAK_DB_HOST}
KC_DB_URL_PORT=${MARIADB_PORT_INTERNAL}
KC_DB_URL_DATABASE=${KEYCLOAK_DB_DATABASE}

KC_DB_USERNAME=${KEYCLOAK_DB_USER}
KC_DB_PASSWORD=${KEYCLOAK_DB_PASSWORD}


# -----------------------------------------------------------------------------
# HTTP behind nginx
# -----------------------------------------------------------------------------
#
# This stays true!
#
# Browser:
#
#   HTTPS -> nginx
#
# nginx:
#
#   HTTP -> keycloak:8080
#
# =============================================================================

KC_HTTP_ENABLED=true

KC_HTTP_RELATIVE_PATH=/auth


# -----------------------------------------------------------------------------
# Public Keycloak hostname
# -----------------------------------------------------------------------------

KC_HOSTNAME=https://${DOMAIN}/auth

KC_HOSTNAME_STRICT=true


# -----------------------------------------------------------------------------
# Reverse Proxy
# -----------------------------------------------------------------------------

KC_PROXY_HEADERS=xforwarded


# -----------------------------------------------------------------------------
# Health
# -----------------------------------------------------------------------------

KC_HEALTH_ENABLED=true


# =============================================================================
# React
# =============================================================================
#
# Keep relative URLs.
#
# The browser automatically uses:
#
#   https://mika.foodcoop.fun/api/
#   https://mika.foodcoop.fun/auth/
#
# =============================================================================

VITE_NAME=foodcoops-pwa

VITE_VERSION=local

VITE_BACKEND_URL=/api/

VITE_KEYCLOAK_URL=/auth/

VITE_KEYCLOAK_REALM=${KEYCLOAK_REALM}

VITE_KEYCLOAK_CLIENT_ID=${KEYCLOAK_FRONTEND_CLIENT_ID}


# =============================================================================
# Mail
# =============================================================================
#
# SMTP-Zugang eines Postfachs bei deinem Mail-Anbieter (z.B. IONOS).
# Wird vom Backend (Rechnungen, Mail an Einkaufsmanagement, ...) UND von
# Keycloak (Passwort vergessen, Einrichtungs-Mail, E-Mail bestätigen) genutzt.
#
# Keycloak bekommt die Werte über den Dienst "keycloak-mail" (compose.yml),
# der nach dem Start einmal läuft. Nach Änderungen hier:
#
#   docker compose up -d backend
#   docker compose up keycloak-mail
#
# Damit Mails nicht im Spam landen: bei der Domain SPF, DKIM und DMARC
# eintragen (die Werte nennt der Mail-Anbieter).
#
# Port 587 = STARTTLS (empfohlen), Port 465 = SSL.
#
# Beispiel Strato: Postfach webmaster@foodcoop.fun mit Alias no-reply@...
#   SPRING_MAIL_HOST=smtp.strato.de
#   SPRING_MAIL_USERNAME=webmaster@foodcoop.fun   (Login des Postfachs)
#   MAIL_FROM=no-reply@foodcoop.fun               (Alias als Absender)
#
# -----------------------------------------------------------------------------

SPRING_MAIL_HOST=smtp.ionos.de

SPRING_MAIL_PORT=587

SPRING_MAIL_USERNAME=

SPRING_MAIL_PASSWORD=

SPRING_MAIL_SMTP_AUTH=true

SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# Absender – muss bei den meisten Anbietern zum SMTP-Konto passen.
# Leer = SPRING_MAIL_USERNAME.
MAIL_FROM=

# Anzeigename des Absenders (optional, leer = FOODCOOP_NAME)
MAIL_FROM_NAME=

# Antwort-Adresse für Keycloak-Mails (optional)
MAIL_REPLY_TO=

# So lange ist der Link in der Einladungs-Mail von Keycloak gültig (Stunden).
# Keycloak-Standard wären 12 Stunden.
KEYCLOAK_LINK_GUELTIG_STUNDEN=72

# Name der Foodcoop – in Betreffzeilen, Grüßen der Mails, auf den
# Bestell-PDFs für die Händler und als Name auf der Keycloak-Anmeldeseite
FOODCOOP_NAME=FoodCoop MiKa

# Betreffzeilen (optional, leer = Standard).
# Platzhalter: %foodcoop%, %datum%, %person%
#
#   Bestätigung an die Person, die eingekauft hat
#   Standard: Dein Einkauf bei der %foodcoop% am %datum%
MAIL_BETREFF_EINKAUF=
#
#   Info an das Einkaufsmanagement
#   Standard: Einkauf von %person% bei der %foodcoop% am %datum%
MAIL_BETREFF_EINKAUFSMANAGEMENT=