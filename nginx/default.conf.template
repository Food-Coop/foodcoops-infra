# =============================================================================
# HTTP
# =============================================================================
#
# Verwendet für:
#
#   1. Let's Encrypt HTTP-01 Challenge
#   2. Redirect aller normalen HTTP-Requests auf HTTPS
#
# =============================================================================

server {
    listen 80 default_server;

    server_name ${ROOT_DOMAIN} ${DOMAIN};


    # =========================================================================
    # Let's Encrypt / Certbot
    # =========================================================================

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }


    # =========================================================================
    # Alles andere -> kanonische HTTPS-Domain
    # =========================================================================

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}


# =============================================================================
# HTTPS - Root Domain
# =============================================================================
#
# Beispiel:
#
#   https://foodcoop.fun/...
#
# wird umgeleitet auf:
#
#   https://mika.foodcoop.fun/...
#
# =============================================================================

server {
    listen 443 ssl;

    server_name ${ROOT_DOMAIN};


    # =========================================================================
    # TLS
    # =========================================================================

    ssl_certificate /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;


    # =========================================================================
    # Redirect auf kanonische Domain
    # =========================================================================

    return 301 https://${DOMAIN}$request_uri;
}


# =============================================================================
# HTTPS - Food-Coop Anwendung
# =============================================================================

server {
    listen 443 ssl default_server;

    server_name ${DOMAIN};


    # =========================================================================
    # TLS
    # =========================================================================

    ssl_certificate /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;


    # =========================================================================
    # Frontend
    # =========================================================================

    root /usr/share/nginx/html;

    index index.html;


    # =========================================================================
    # Docker DNS
    # =========================================================================
    #
    # Docker stellt unter 127.0.0.11 einen internen DNS-Resolver bereit.
    #
    # Durch die Verwendung von Variablen in proxy_pass versucht nginx nicht,
    # backend und keycloak schon beim eigenen Start aufzulösen.
    #
    # Dadurch kann nginx / das Frontend bereits laufen, während Backend oder
    # Keycloak noch starten.
    #
    # =========================================================================

    resolver 127.0.0.11 ipv6=off valid=10s;

    set $backend_upstream backend:8080;
    set $keycloak_upstream keycloak:8080;


    # =========================================================================
    # Backend API
    # =========================================================================
    #
    # Öffentlich:
    #
    #   https://${DOMAIN}/api/brotBestand
    #
    # Docker-intern:
    #
    #   http://backend:8080/brotBestand
    #
    # Das Präfix /api/ wird entfernt.
    #
    # =========================================================================

    location = /api {
        return 308 /api/;
    }


    location /api/ {

        # /api/brotBestand -> /brotBestand
        rewrite ^/api/(.*)$ /$1 break;

        proxy_pass http://$backend_upstream;

        proxy_http_version 1.1;


        # ---------------------------------------------------------------------
        # Forwarded Headers
        # ---------------------------------------------------------------------

        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Forwarded-Port 443;


        # ---------------------------------------------------------------------
        # Timeouts
        # ---------------------------------------------------------------------

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }


    # =========================================================================
    # Keycloak
    # =========================================================================
    #
    # Öffentlich:
    #
    #   https://${DOMAIN}/auth/
    #
    # Docker-intern:
    #
    #   http://keycloak:8080/auth/
    #
    # /auth bleibt erhalten, weil Keycloak selbst mit
    #
    #   KC_HTTP_RELATIVE_PATH=/auth
    #
    # läuft.
    #
    # =========================================================================

    location = /auth {
        return 308 /auth/;
    }


    location /auth/ {

        proxy_pass http://$keycloak_upstream;

        proxy_http_version 1.1;


        # ---------------------------------------------------------------------
        # Forwarded Headers
        # ---------------------------------------------------------------------

        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Forwarded-Port 443;


        # ---------------------------------------------------------------------
        # Timeouts
        # ---------------------------------------------------------------------

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }


    # =========================================================================
    # Versteckte / sensible Dateien blockieren
    # =========================================================================
    #
    # Beispiele:
    #
    #   /.env
    #   /.env.production
    #   /.git/config
    #   /config/.env
    #   /.DS_Store
    #
    # /.well-known bleibt davon ausgenommen.
    #
    # =========================================================================

    location ~ /\.(?!well-known/) {
        return 404;
    }


    # =========================================================================
    # React Frontend
    # =========================================================================
    #
    # SPA-Fallback:
    #
    #   /irgendeine/react/route
    #
    # wird auf:
    #
    #   /index.html
    #
    # zurückgeführt.
    #
    # =========================================================================

    location / {
        try_files $uri $uri/ /index.html;
    }
}