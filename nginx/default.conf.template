# =============================================================================
# HTTP
# =============================================================================
#
# Used for:
#
#   1. Let's Encrypt HTTP-01 challenge
#   2. Redirecting all normal HTTP traffic to HTTPS
#
# =============================================================================

server {
    listen 80 default_server;

    server_name foodcoop.fun mika.foodcoop.fun;


    # -------------------------------------------------------------------------
    # Let's Encrypt / Certbot
    # -------------------------------------------------------------------------

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }


    # -------------------------------------------------------------------------
    # Everything else -> canonical HTTPS URL
    # -------------------------------------------------------------------------

    location / {
        return 301 https://mika.foodcoop.fun$request_uri;
    }
}


# =============================================================================
# HTTPS - root domain
# =============================================================================
#
# https://foodcoop.fun/...
#
# becomes:
#
# https://mika.foodcoop.fun/...
#
# =============================================================================

server {
    listen 443 ssl;

    server_name foodcoop.fun;


    # -------------------------------------------------------------------------
    # TLS
    # -------------------------------------------------------------------------

    ssl_certificate
        /etc/letsencrypt/live/foodcoop.fun/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/foodcoop.fun/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;


    # -------------------------------------------------------------------------
    # Redirect to canonical hostname
    # -------------------------------------------------------------------------

    return 301 https://mika.foodcoop.fun$request_uri;
}


# =============================================================================
# HTTPS - Food-Coop Application
# =============================================================================

server {
    listen 443 ssl default_server;

    server_name mika.foodcoop.fun;


    # =========================================================================
    # TLS
    # =========================================================================

    ssl_certificate
        /etc/letsencrypt/live/foodcoop.fun/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/foodcoop.fun/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;


    # =========================================================================
    # Frontend
    # =========================================================================

    root /usr/share/nginx/html;

    index index.html;


    # =========================================================================
    # Docker DNS
    # =========================================================================
    #
    # Resolve backend/keycloak dynamically.
    #
    # This allows nginx/frontend to start even if the backend is temporarily
    # unavailable.
    #
    # =========================================================================

    resolver 127.0.0.11 ipv6=off valid=10s;

    set $backend_upstream backend:8080;

    set $keycloak_upstream keycloak:8080;


    # =========================================================================
    # Backend API
    # =========================================================================
    #
    # Browser:
    #
    #   https://mika.foodcoop.fun/api/brotBestand
    #
    # Backend:
    #
    #   http://backend:8080/brotBestand
    #
    # The /api prefix is intentionally removed.
    #
    # =========================================================================

    location = /api {
        return 308 /api/;
    }


    location /api/ {

        rewrite ^/api/(.*)$ /$1 break;

        proxy_pass http://$backend_upstream;

        proxy_http_version 1.1;


        # ---------------------------------------------------------------------
        # Proxy headers
        # ---------------------------------------------------------------------

        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Forwarded-Port 443;
    }






    # =========================================================================
    # Keycloak
    # =========================================================================
    #
    # Public authentication endpoints.
    #
    # Browser:
    #
    #   https://mika.foodcoop.fun/auth/realms/foodcoop/...
    #
    # Docker:
    #
    #   http://keycloak:8080/auth/realms/foodcoop/...
    #
    # =========================================================================

    location = /auth {
        return 308 /auth/;
    }


    location /auth/ {

        proxy_pass http://$keycloak_upstream;

        proxy_http_version 1.1;


        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Forwarded-Port 443;
    }


    # =========================================================================
    # React Frontend
    # =========================================================================
    # Keine versteckten Dateien ausliefern
    # .env, .git, .DS_Store, ...
    location ~ /\.(?!well-known/) {
        return 404;
    }
    location / {

        try_files $uri $uri/ /index.html;
    }
}